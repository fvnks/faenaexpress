// Schema de datos de "Facturas".
// Dominio: registro de compras, ventas, gastos y quién paga cada gasto.
// Multiempresa: cada empresa tiene sus propios datos y cada usuario un rol por
// empresa (Membership).
// Contexto fiscal: Chile, CLP, IVA 19%.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organizaciones: la cuenta que agrupa empresas y usuarios.
//
// `Company` sigue siendo el inquilino de datos; la organización es quien paga,
// quien agrupa y quien decide quién puede revisar varias empresas.
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER // dueño de la organización: otorga permisos y crea empresas
  ADMIN // administra la organización y sus miembros
  BILLING // solo facturación (reservado para los planes)
  MEMBER // miembro sin gestión
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrgMember[]
  companies Company[]
  invites   Invitation[]
  modules   OrganizationModule[]
  subscription Subscription?
  usage     UsageRecord[]
  accessLogs AccessLog[]
  schools     School[]
}

// Pertenencia de un usuario a una organización.
// `canSwitchCompanies` es el permiso de "revisar las empresas" del perfil: apagado por
// defecto, sin él el usuario solo ve su propia empresa y no aparece el selector.
model OrgMember {
  id                 String  @id @default(cuid())
  userId             String
  organizationId     String
  orgRole            OrgRole @default(MEMBER)
  canSwitchCompanies Boolean @default(false)
  active             Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Invitación con enlace copiable. El OWNER la genera desde Configuración → Invitaciones,
// la copia y la manda por WhatsApp/correo/personal. Al abrir `/invitacion/<token>`:
//   - Si no tiene cuenta: crea User + OrgMember + Membership. El correo viene fijado
//     por la invitación; la contraseña es provisional y el usuario debe cambiarla al entrar.
//   - Si ya tiene cuenta: se valida que el correo de la invitación coincida con su
//     correo (evita que otra persona use el enlace) y se le agrega a la organización.
// Token con hash, expira en 72 h, solo se usa una vez.
model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?  // empresa destino; null = todas las de la organización
  email          String   // correo del invitado (fijo, no editable en el registro)
  role           Role     @default(VIEWER)
  tokenHash      String   @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?

  @@unique([organizationId, email])
}

// ---------------------------------------------------------------------------
// Plataforma (Yellow ERP): el equipo que opera el SaaS.
//
// `PlatformStaff` NO es lo mismo que el ADMIN de una empresa ni que el OWNER de
// una organización: es el personal del proveedor, con acceso transversal a todas
// las cuentas. Va en la base (no en un flag de entorno) para que el acceso sea
// auditable y revocable sin desplegar.
// ---------------------------------------------------------------------------

enum PlatformLevel {
  SUPPORT // solo lee (soporte: mirar, no tocar)
  OPERATOR // actúa: crea organizaciones, invitaciones, cambia planes
  OWNER // todo, incluido el personal de plataforma
}

model PlatformStaff {
  id        String        @id @default(cuid())
  userId    String        @unique
  level     PlatformLevel @default(SUPPORT)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation("PlatformStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
}

// Auditoría de plataforma: lo que hace el equipo de Yellow ERP sobre las cuentas
// de los clientes. Es por usuario (no por empresa) porque una acción puede no
// tener empresa (crear una organización, cambiar un plan). `organizationId` queda
// como contexto cuando la acción sí afecta a una cuenta.
model PlatformAudit {
  id             String      @id @default(cuid())
  staffUserId    String // id como texto: el log sobrevive si se borra el usuario
  staffUserName  String
  staffUserEmail String
  level          PlatformLevel
  action         AuditAction
  entityType     String
  entityId       String?
  organizationId String?
  summary        String
  changes        Json?
  createdAt      DateTime    @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

// Módulos que una organización tiene contratados.
//
// Un módulo es una parte del producto que se puede vender por separado (RRHH,
// inventario, comisiones, conciliación bancaria). La fila es el estado EXPLÍCITO
// de esa combinación: si existe, manda la fila. Si NO existe, aplica el
// defecto, que es «habilitado» — la maqueta no bloquea a nadie, así que una
// organización sin filas tiene todo lo que existe.
//
// `enabledFrom`/`enabledTo` dejan el historial y abren la puerta a las
// ventanas que venga de un plan. `source` dice de dónde salió la habilitación:
// del plan o de la mano del operador (un módulo vendido suelto).
model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleCode     String
  enabled        Boolean   @default(true)
  enabledFrom    DateTime  @default(now())
  enabledTo      DateTime? // null = vigente
  // "plan" (viene del plan contratado) | "manual" (lo activó el operador)
  source         String    @default("manual")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleCode])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Planes y suscripciones
//
// `Plan` es el CATÁLOGO (lo que vendes) y `Subscription` lo que una cuenta
// tiene contratado. No son lo mismo: si se mezclaran, habría que duplicar el
// catálogo por cliente.
//
// La maqueta arranca con un solo plan `Free` sin topes (los límites en `null`)
// y una suscripción `Free` por organización: la pantalla de facturación queda
// completa desde el día uno, pero no bloquea a nadie. Los números reales
// (y la pasarela) se llenan después; el modelo no cambia.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL // prueba: al vencer, avisos (y solo lectura)
  ACTIVE // al día
  PAST_DUE // no pagó: avisos, nunca se borra nada
  CANCELED // dio de baja: los datos se quedan
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  // Precio en CLP por período (0 = gratis).
  priceCLP Int @default(0)
  // "MONTHLY" | "YEARLY"
  period String @default("MONTHLY")
  // Límites. `null` = sin tope.
  maxCompanies    Int?
  maxUsers        Int?
  maxDocsPerMonth Int?
  // Módulos incluidos (códigos de `src/lib/org-modules.ts`). Los que se
  // vendan sueltos se activan aparte, con fila propia en OrganizationModule.
  modules String[]
  active  Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active])
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(ACTIVE)
  startedAt      DateTime           @default(now())
  // Fin del período en curso (NULL = mensual sin tope de cierre).
  currentPeriodEnd DateTime?
  // Prueba: hasta cuándo dura.
  trialEndsAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
}

// Consumo del período en curso por organización. Es un contador, no un
// `count(*)` sobre la tabla entera en cada petición: los documentos se cuentan
// al crearlos.
model UsageRecord {
  id             String @id @default(cuid())
  organizationId String
  // Período en formato YYYY-MM.
  period         String
  documentsCreated Int @default(0)
  activeUsers      Int @default(0)
  bankSyncs        Int @default(0)
  computedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// COLEGIOS: dominio escolar (módulo aparte de Facturas)
//
// Es un producto distinto que comparte la plataforma (organización, planes,
// auditoría, consola), pero con su propio aislamiento: aquí el inquilino de
// los datos es el ESTABLECIMIENTO (colegio), no la empresa. El `Organization`
// es el sostenedor, que puede tener varios.
//
// Lo que manda en el diseño NO es laerpferencia sino la norma: la Circular N°30
// (Libro de Clases Digital) define qué registros existen y el Decreto 67 los
// criterios de promoción (85% de asistencia). Ver `PLAN-COLEGIOS.md`.
// ---------------------------------------------------------------------------

enum SchoolRole {
  DIRECTOR // dirección: ve y decide todo en el colegio
  UTP // jefatura de estudios: lo académico
  ADMIN // administración: secretaría, inspección,admisiones
  TEACHER // docente: sus cursos y sus registros
  STAFF // funcionario: asistencia y reemplazos
  VIEWER // solo lectura
}

enum SchoolLevel {
  PARVULARIA
  PREBASICA
  BASICA
  MEDIA
  TECNICO
}

enum StudentStatus {
  ACTIVE // cursando
  TRANSFERRED // seMudó de colegio
  WITHDRAWN // se retiró
  GRADUATED // egresó
}

model School {
  id             String      @id @default(cuid())
  organizationId String? // el sostenedor; null si el colegio no tiene uno
  name           String
  rut            String?
  level          SchoolLevel @default(BASICA)
  address        String?
  commune        String?
  phone          String?
  email          String?
  // RUT del sostenedor y del colegio se necesitan aparte: el RUT de la unidad
  // educational y el del establecimiento son distintos.
  sostenedorRut  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships SchoolMembership[]
  courses     Course[]
  students    Student[]
  guardians   Guardian[]
  teachers    Teacher[]
  subjects    Subject[]
  sessions    ClassSession[]
  evaluations Evaluation[]
  circulars   Circular[]
  absences    StudentAbsence[]
  periods     GradingPeriod[]
  documents   StudentDocument[]
  consents    StudentConsent[]
  justifications JustificationRequest[]
  appointments  Appointment[]
  conductCases  ConductCase[]
  protocols     ConductProtocol[]
  plans         ConvivenciaPlan[]

  @@index([organizationId])
}

// Acceso de una persona a un colegio, con su rol ahí. Es el equivalente
// escolar de `Membership` (que es de empresas).
model SchoolMembership {
  id        String     @id @default(cuid())
  userId    String
  schoolId  String
  role      SchoolRole @default(VIEWER)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
}

// Curso: "3°Básico A", año escolar 2026.
model Course {
  id       String      @id @default(cuid())
  schoolId String
  name     String
  level    SchoolLevel @default(BASICA)
  year     Int // año escolar
  section  String? // "A", "B"
  active   Boolean     @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  assignments TeachingAssignment[]
  sessions     ClassSession[]
  evaluations Evaluation[]
  circulars   Circular[]

  @@index([schoolId, year])
}

model Student {
  id        String        @id @default(cuid())
  schoolId  String
  rut       String?
  firstName String
  lastName  String
  birthDate DateTime?
  gender    String? // "F", "M", "OTRO"
  address   String?
  commune   String?
  email     String?
  phone     String?
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  guardianships Guardianship[]
  attendances   AttendanceRecord[]
  absences      StudentAbsence[]
  grades        Grade[]
  documents     StudentDocument[]
  consents      StudentConsent[]
  justifications JustificationRequest[]
  appointments  Appointment[]
  caseRoles       CaseParticipant[]

  @@index([schoolId, lastName])
}

// Apoderado (o apoderada): el contacto del estudiante. No es personal del
// colegio: accede al PORTAL, no al sistema interno.
model Guardian {
  id       String  @id @default(cuid())
  schoolId String
  rut      String?
  name     String
  email    String?
  phone    String?
  // Código de acceso al portal del apoderado. Es un secreto de la familia: con
  // él se ven todos los hijos de ese apoderado. Lo entrega el colegio en
  // persona y el colegio lo puede rotar cuando quiere.
  accessCode          String?   @unique
  accessCodeCreatedAt DateTime?
  lastAccessAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardianships Guardianship[]
  sessions      GuardianSession[]
  acks           CircularAck[]
  circulars      Circular[]
  justifications JustificationRequest[]
  appointments   Appointment[]

  @@index([schoolId, name])
}

// La sesión del portal del apoderado. Es aparte de la del empleado: el
// apoderado no es personal del colegio y no tiene membresía de ninguna clase.
model GuardianSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  guardianId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
}

// Vínculo entre apoderado y estudiante, con el tipo de responsabilidad.
model Guardianship {
  id         String   @id @default(cuid())
  studentId  String
  guardianId String
  // "TITULAR", "SUPLENTE", "EMERGENCIA"
  type       String   @default("TITULAR")
  createdAt  DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
}

model Teacher {
  id        String   @id @default(cuid())
  schoolId  String
  rut       String?
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  sessions     ClassSession[]

  @@index([schoolId, name])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  code      String // "MAT"
  name      String // "Matemática"
  // Las calificaciones de Religión, Consejo de Curso y Orientación no inciden
  // en el promedio final anual ni en la promoción (Art. 7 del Decreto 67/2018).
  // El colegio marca cuáles son esas.
  countsForPromotion Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  sessions     ClassSession[]
  evaluations Evaluation[]

  @@unique([schoolId, code])
}

// Qué docente hace qué asignatura en qué curso. Es el corazón del libro de
// clases: sin esto no hay quién registre la asistencia ni las notas.
model TeachingAssignment {
  id           String   @id @default(cuid())
  courseId     String
  subjectId    String
  teacherId    String
  weeklyHours  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, subjectId])
  @@index([teacherId])
}

// Matrícula de un estudiante en un curso.
model Enrollment {
  id         String   @id @default(cuid())
  courseId   String
  studentId  String
  enrolledAt DateTime @default(now())
  // "ACTIVE" (cursando), "TRASLADO" (cambió de curso), "RETIRADO" (se fue).
  status     String   @default("ACTIVE")
  // Por qué se cerró la matrícula. La trazabilidad importa: un traslado o un
  // retiro tienen que quedar explicados.
  statusReason String?
  // Cuándo se cerró la matrícula (traslado o retiro).
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Libro de clases digital (Circular N°30)
//
// El MINEDUC extiende el estándar CEDS: el libro de clases se mapea a
// `SchoolCalendarItem` (cada día del calendario escolar) con la asistencia
// del alumno y del docente, más las respuestas de evaluación. El archivo que
// se entrega es un `json.zip` que su contenedor (`edemineduc/etl`) parsea y
// valida. Ver `PLAN-COLEGIOS.md` §2.
//
// Lo que la norma exige y el modelo tiene queensure:
//   - Registros completos durante el año, no al momento de la fiscalización.
//   - Trazabilidad: quién registró cada dato y cuándo, y las correcciones.
//   - Respaldo exportable.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT // presente
  ABSENT // ausente
  LATE // atraso
  JUSTIFIED // justificada (con justificativo): cuenta como asistencia
  EXCUSED // eximido (permiso, retirada anticipada): no cuenta ni a favor ni en contra
}

// Una clase dictada: curso + asignatura + docente + fecha. Es la unidad del
// registro diario y la que se exporta al EDE.
model ClassSession {
  id        String @id @default(cuid())
  schoolId  String
  courseId  String
  subjectId String
  teacherId String
  date      DateTime
  // Período del horario (1ª, 2ª...). No es opcional: la clave única de la
  // clase lo necesita, y una clase sin período es la primera.
  period    Int      @default(1)
  startTime String? // "08:30"
  endTime   String?
  // El registro de la clase: contenidos, actividades y objetivos.
  contents   String?
  activities String?
  objectives String?
  // Trazabilidad (la Circular 30 la pide): quién registró y cuándo.
  recordedById String
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]
  justifications JustificationRequest[]

  @@unique([courseId, subjectId, date, period])
  @@index([schoolId, date])
  @@index([teacherId, date])
}

// La asistencia de un alumno en una clase. El estado lleva el justificativo
// cuando corresponde.
model AttendanceRecord {
  id         String @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus @default(PRESENT)
  minutesLate Int @default(0)
  // "ENFERMEDAD", "PERMISO", "RETIRADA_TEMPORANA", "FALTA_JUSTIFICADA", "OTRO"
  justificationType String?
  justificationNote String?
  recordedById String
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// Permisos, licencias y retiradas anticipadas: días en que el alumno no asiste
// por un motivo con registro. No cuentan ni a favor ni en contra del 85%.
model StudentAbsence {
  id        String @id @default(cuid())
  schoolId  String
  studentId String
  // "PERMISO", "LICENCIA_MEDICA", "RETIRADA_ANTICIPADA", "OTRO"
  type      String
  reason    String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@index([studentId, startDate])
}

// ---------------------------------------------------------------------------
// Usuarios, roles y sesiones
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // acceso total dentro de la empresa, gestiona usuarios y configuración
  ACCOUNTANT // contabilidad: compras, ventas, gastos y reportes
  SALES // ventas y clientes
  VIEWER // solo lectura
}

// Nivel de acceso al inventario. Se asigna por empresa (Membership) al crear o
// editar un usuario; es independiente del rol general.
enum InventoryAccess {
  NONE
  VIEW
  EDIT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  // Los usuarios invitados entran con una contraseña provisional: obligatorio cambiarla.
  mustChangePassword Boolean @default(false)
  // Segundo factor (TOTP). El secreto va cifrado con la misma llave que el SII
  // y Defontana: nunca en claro, ni siquiera en la base.
  totpSecretEnc  String?
  totpEnabled    Boolean   @default(false)
  totpEnabledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  purchases       Purchase[] @relation("PurchaseCreatedBy")
  sales           Sale[]     @relation("SaleCreatedBy")
  createdExpenses Expense[]  @relation("ExpenseCreatedBy")
  createdRemunerations Remuneration[] @relation("RemunerationCreatedBy")
  createdPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodCreatedBy")
  approvedAbsences Absence[] @relation("AbsenceApprovedBy")
  uploadedWorkerDocuments WorkerDocument[] @relation("WorkerDocumentUploadedBy")
  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  createdProductLots    ProductLot[]    @relation("ProductLotCreatedBy")
  createdStockCounts    StockCount[]    @relation("StockCountCreatedBy")
  createdCommissionAssignments CommissionAssignment[] @relation("CommissionAssignmentCreatedBy")
  createdDispatchGuides        DispatchGuide[]        @relation("DispatchGuideCreatedBy")
  closedCommissionMonths       CommissionClose[]      @relation("CommissionCloseClosedBy")
  bankSyncs                    BankSync[]             @relation("BankSyncBy")
  bankReconciliations          Reconciliation[]       @relation("BankReconciliationBy")
  createdPayments              Payment[]              @relation("PaymentCreatedBy")
  orgMembers                   OrgMember[]
  invitations                  Invitation[]
  schoolMemberships            SchoolMembership[]
  // Personal de plataforma (Yellow ERP). Un usuario normal no lo es.
  platformStaff                PlatformStaff? @relation("PlatformStaffUser")
  recoveryCodes                RecoveryCode[]
  accessLogs                   AccessLog[]
}

// Códigos de recuperación: por si el cliente pierde su teléfono. Se muestran
// una sola vez y se guardan cifrados (hash), nunca en claro.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Entradas a la cuenta: quién entró, desde dónde y cuándo. Es el registro que
// el dueño de la organización puede ver («quién entró a mi cuenta»).
model AccessLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  userEmail     String
  ip             String?
  userAgent      String?
  // "login" | "logout" | "2fa" | "failed"
  kind           String   @default("login")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// Pertenencia de un usuario a una empresa, con el rol que cumple en ella.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(VIEWER)
  inventoryAccess InventoryAccess @default(NONE)
  // Excepciones por sección para ESTA persona: {"rrhh": "EDIT", "inventario": "NONE"}.
  // Lo que no esté aquí lo decide el rol. Sirve para los contratos que no son
  // "todo o nada": «Juan entra a RRHH, pero no a Inventario».
  sectionAccess Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// Sesión con token opaco: se guarda el hash, nunca el token en claro.
//
// La impersonación (Fase B2) usa una sesión SEPARADA de la del operador: el
// personal de plataforma no cambia su propia sesión, crea una sesión aparte que
// actúa como un usuario del cliente. Así «salir de la impersonación» es
// siempre un clic y no un «volver a mi cuenta» que se puede perder.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Impersonación: presente solo en la sesión de soporte.
  // `impersonatedByStaffId` es el id del usuario del equipo de plataforma (texto
  // plano, como en AuditLog: el registro sobrevive si se borra el usuario).
  impersonatedByStaffId     String?
  impersonatedOrganizationId String? // organización del cliente
  impersonatedUntil          DateTime? // tope duro de tiempo
  // Motivo que dejó el operador al entrar (queda en la auditoría).
  impersonationReason        String?
  // Sesión a medio camino: la contraseña está bien pero falta el segundo factor.
  // Sirve SOLO para configurar o confirmar el 2FA: `requireUser` la expulsa a
  // la pantalla del 2FA en cualquier otra página.
  totpPending                Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([impersonatedByStaffId])
}

// ---------------------------------------------------------------------------
// Empresa (configuración fiscal). Cada empresa es un espacio de datos aislado.
// ---------------------------------------------------------------------------

model Company {
  id               String   @id @default(cuid())
  organizationId   String?  // pertenece a una organización; null en instalaciones standalone.
  name             String
  rut       String?
  address   String?
  city      String?
  commune   String? // comuna del emisor (para el PDF)
  giro      String? // giro del emisor (para el PDF)
  email     String?
  phone     String?
  ivaRate       Int      @default(19) // porcentaje de IVA
  retentionRate Int      @default(0) // porcentaje de retención de honorarios (boletas)
  currency      String   @default("CLP")
  // Alertas configurables (notificaciones).
  alertDueSoonDays     Int    @default(5)
  alertPorCobrarLimit   Int?   // límite de "por cobrar" para disparar alerta (null = desactivado)
  alertPorPagarLimit    Int?   // límite de "por pagar"
  alertReembolsosLimit  Int?   // límite de reembolsos pendientes
  // Tasas de descuentos laborales (%) para liquidaciones.
  afpRate          Int    @default(10)
  healthRate       Int    @default(7)
  unemploymentRate Int    @default(1)
  anualBonusRate   Int    @default(0)
  // Login automático del SII. `siiClaveEnc` guarda la Clave Tributaria CIFRADA
  // con AES-256-GCM (llave SII_SECRET_KEY); nunca en claro. Ver src/lib/sii-credentials.ts.
  siiRut       String?
  siiClaveEnc  String?

  // Defontana (el ERP con el que la empresa emite sus DTE). Permite traer a
  // pedido el XML de una factura desde el Libro de Compras del ERP.
  // `defontanaClaveEnc` y `defontanaTokenEnc` van cifrados con la misma llave
  // que el SII; el token se cachea porque dura un año. Ver src/lib/defontana/.
  defontanaEmail    String?
  defontanaClaveEnc String?
  defontanaTokenEnc String?
  defontanaTokenExp DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships            Membership[]
  partners               Partner[]
  categories             Category[]
  areas                  Area[]
  salespeople            Salesperson[]
  payers                 Payer[]
  workers                Worker[]
  remunerations          Remuneration[]
  purchases              Purchase[]
  sales                  Sale[]
  purchaseItems          PurchaseItem[]
  saleItems              SaleItem[]
  expenses               Expense[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  paymentMethodCatalogs  PaymentMethodCatalog[]
  units                  Unit[]
  productCategories      ProductCategory[]
  products               Product[]
  productStocks          ProductStock[]
  stockMovements         StockMovement[]
  warehouses             Warehouse[]
  stockCounts            StockCount[]
  commissionAssignments  CommissionAssignment[]
  commissionEntries      CommissionEntry[]
  commissionCloses       CommissionClose[]
  dispatchGuides         DispatchGuide[]
  payrollPeriods         PayrollPeriod[]
  absences              Absence[]
  workerDocuments       WorkerDocument[]
  productLots           ProductLot[]
  bankAccounts          BankAccount[]
  bankMovements         BankMovement[]
  bankSyncs             BankSync[]
  bankReconciliations  Reconciliation[]
  payments             Payment[]
  invites              Invitation[]

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Terceros: clientes y proveedores
// ---------------------------------------------------------------------------

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Partner {
  id        String      @id @default(cuid())
 companyId String
  type      PartnerType @default(CUSTOMER)
  name      String
  rut       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  commune   String? // comuna del socio (para el PDF)
  giro      String? // giro del socio (para el PDF)
  notes     String?
  active    Boolean     @default(true)

  salespersonId String?
  salesperson   Salesperson? @relation("PartnerDefaultSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  dispatchGuides DispatchGuide[]
  products  Product[]  @relation("ProductSupplier")

  @@unique([companyId, rut])
  @@index([companyId, name])
}

// ---------------------------------------------------------------------------
// Catálogos administrables (por empresa)
// ---------------------------------------------------------------------------

enum CategoryKind {
  EXPENSE
  INCOME
  BOTH
}

model Category {
  id        String       @id @default(cuid())
  companyId String
  name      String
  kind      CategoryKind @default(EXPENSE)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  expenses  Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Área de la empresa.
model Area {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
  expenses  Expense[]
  workers   Worker[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Vendedor que realizó la venta (catálogo administrable).
// Regla de cómputo de la comisión de un vendedor. Es POR VENDEDOR, no global:
// unos comisionan por factura emitida y otros por mercancía despachada.
enum CommissionRule {
  INVOICE // Comisiona por todas las facturas emitidas en el período.
  GUIDE   // Comisiona solo por las que traen guía de despacho; el resto se asigna a mano.
}

model Salesperson {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)

  // Porcentaje en CENTÉSIMAS para no pelear con decimales: 250 = 2,50%.
  commissionRate Int            @default(0)
  commissionRule CommissionRule @default(INVOICE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales       Sale[]
  defaultPartners Partner[] @relation("PartnerDefaultSalesperson")
  assignments CommissionAssignment[]
  entries     CommissionEntry[]
  dispatchGuides DispatchGuide[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Quién pagó un gasto. Lista administrable: puede ser una persona o la caja
// de la empresa, sin necesidad de que tenga un usuario en el sistema.
model Payer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
  remunerations Remuneration[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Trabajador de la empresa: permite asociar gastos de personal (sueldos,
// aguinaldos, adelantos) a una persona y analizarlos en reportes.
model Worker {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rut       String?
  active    Boolean  @default(true)
  // Ficha laboral básica.
  position        String?
  areaId          String?
  email           String?
  phone           String?
  address         String?
  city            String?
  birthDate       DateTime? @db.Date
  hireDate        DateTime? @db.Date
  terminationDate DateTime? @db.Date
  contractType    String?
  baseAmount      Int?
  bankName        String?
  bankAccount     String?
  afp             String?
  healthPlan      String?
  status          String?
  notes           String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  expenses      Expense[]
  remunerations Remuneration[]
  absences      Absence[]
  documents       WorkerDocument[]
  payrollEntries  PayrollEntry[]

  @@unique([companyId, name])
  @@unique([companyId, rut])
  @@index([companyId])
  @@index([companyId, areaId])
  @@index([companyId, active])
}

// Ausencias o licencias de un trabajador. Registro laboral, independiente del pago.
enum AbsenceType {
  SICK
  VACATION
  PERSONAL
  UNPAID
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Absence {
  id           String         @id @default(cuid())
  companyId    String
  workerId     String
  type         AbsenceType
  status       AbsenceStatus  @default(PENDING)
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  paid         Boolean        @default(false)
  reason       String?
  notes        String?
  approvedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("AbsenceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId, workerId])
  @@index([companyId, startDate])
  @@index([companyId, type])
}

// Documento adjunto a un trabajador (contrato, anexo, certificado, etc.).
enum WorkerDocumentType {
  CONTRACT
  ANNEX
  CERTIFICATE
  OTHER
}

model WorkerDocument {
  id            String @id @default(cuid())
  companyId     String
  workerId      String
  title         String
  type          WorkerDocumentType @default(OTHER)
  description   String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  fileData      Bytes
  uploadedById  String
  createdAt     DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("WorkerDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([companyId, workerId])
}

// Pago de remuneración registrado en RRHH: sueldos, aguinaldos, bonos o
// adelantos. Genera automáticamente un gasto asociado (sin IVA).
enum RemunerationType {
  SUELDO
  AGUINALDO
  BONO
  ADELANTO
  OTRO
}

model Remuneration {
  id          String          @id @default(cuid())
  companyId   String
  workerId    String
  type        RemunerationType
  period      String? // AAAA-MM (libre)
  date        DateTime // fecha de pago
  amount      Int // monto líquido pagado
  paidById    String
  expenseId   String? // gasto generado automáticamente
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker    Worker    @relation(fields: [workerId], references: [id])
  paidBy    Payer     @relation(fields: [paidById], references: [id])
  expense   Expense?  @relation(fields: [expenseId], references: [id])
  createdBy User      @relation("RemunerationCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, date])
  @@index([companyId, workerId])
  @@index([companyId, type])
}

// Medios de pago configurables por empresa (catálogo)
model PaymentMethodCatalog {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Inventario: productos, unidades, categorías de producto y movimientos.
// Valorización por promedio ponderado (PPP). Una sola bodega por ahora
// (multi-bodega queda preparado para más adelante).
// ---------------------------------------------------------------------------

// Unidad de medida del producto (UN, KG, LT, MT, CJ…), administrable por empresa.
model Unit {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Categoría de producto (independiente de las categorías de gasto/ingreso).
model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Tipo de movimiento de stock. `quantity` se guarda siempre positiva; el signo
// lo determina el tipo. TRANSFER mueve stock entre bodegas y no altera el total
// de la empresa.
enum StockMovementType {
  IN // entrada (compra, ingreso)
  OUT // salida (venta, consumo)
  ADJUST_IN // ajuste al alza
  ADJUST_OUT // ajuste a la baja
  WASTE // merma o pérdida
  INITIAL // inventario inicial
  TRANSFER // traslado entre bodegas (usa warehouseId y toWarehouseId)
}

// Bodega (almacén). Toda empresa nace con una por defecto; el esquema ya
// soporta varias para transferencias.
model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  location  String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks    ProductStock[]
  origins   StockMovement[]  @relation("MovementOrigin")
  targets   StockMovement[]  @relation("MovementDestination")
  counts    StockCount[]
  lots      ProductLot[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  sku         String
  name        String
  description String?
  unitId      String?
  categoryId  String?
  supplierId  String?
  ivaAffected Boolean  @default(true)
  costNet     Int      @default(0) // costo neto unitario vigente (PPP)
  priceNet    Int? // precio de venta neto
  minStock    Decimal? @db.Decimal(14, 3)
  location    String?
  tracksStock Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit      Unit?           @relation(fields: [unitId], references: [id])
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  supplier  Partner?        @relation("ProductSupplier", fields: [supplierId], references: [id])
  stocks    ProductStock[]
  movements StockMovement[]
  countItems StockCountItem[]
  purchaseItems PurchaseItem[] @relation("PurchaseItemProduct")
  saleItems     SaleItem[]     @relation("SaleItemProduct")
  lots          ProductLot[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, categoryId])
}

// Saldo vigente por producto y bodega. Se actualiza en la misma transacción que
// el movimiento. `avgCost` es el costo promedio ponderado por unidad (PPP) de
// esa bodega.
model ProductStock {
  productId   String
  warehouseId String
  companyId   String
  quantity    Decimal  @db.Decimal(14, 3) @default(0)
  avgCost     Decimal  @db.Decimal(14, 4) @default(0)
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([companyId])
  @@index([companyId, warehouseId])
}

// Movimiento de inventario (kardex). `quantity` es la magnitud; el signo lo
// aporta `type`. `warehouseId` es la bodega de origen; `toWarehouseId` solo se
// usa en TRANSFER.
model StockMovement {
  id            String            @id @default(cuid())
  companyId     String
  productId     String
  type          StockMovementType
  date          DateTime
  quantity      Decimal           @db.Decimal(14, 3)
  unitCost      Int? // costo neto unitario (entrada / inventario inicial)
  warehouseId   String?
  toWarehouseId String?
  reason        String?
  reference     String? // folio o documento de respaldo
  notes         String?
  createdById   String
  createdAt     DateTime          @default(now())

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation("MovementOrigin", fields: [warehouseId], references: [id], onDelete: SetNull)
  toWarehouse Warehouse? @relation("MovementDestination", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  createdBy   User       @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productId, date])
  @@index([companyId, date])
  @@index([companyId, warehouseId])
}

// ---------------------------------------------------------------------------
// Conteo físico (inventario cíclico)
// ---------------------------------------------------------------------------

enum StockCountStatus {
  OPEN // en levantamiento
  CLOSED // cerrado; las diferencias ya generaron ajustes
}

// Conteo físico de una bodega. Al cerrarlo, cada diferencia entre lo contado y
// el saldo del sistema genera un ADJUST_IN o ADJUST_OUT en el kardex.
model StockCount {
  id          String            @id @default(cuid())
  companyId   String
  warehouseId String?
  code        String // CCT-0001…
  date        DateTime
  notes       String?
  status      StockCountStatus  @default(OPEN)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  items     StockCountItem[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, date])
}

model StockCountItem {
  id              String   @id @default(cuid())
  stockCountId    String
  productId       String
  systemQuantity  Decimal  @db.Decimal(14, 3) // saldo al abrir el conteo
  countedQuantity Decimal? @db.Decimal(14, 3) // null = aún no contado
  movementId      String? // ajuste generado al cerrar
  notes           String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Compras y ventas
// ---------------------------------------------------------------------------

enum DocumentType {
  INVOICE // Factura
  RECEIPT // Boleta
  CREDIT_NOTE // Nota de crédito
  DEBIT_NOTE // Nota de débito
  QUOTATION // Cotización (no tributario)
  OTHER
}

// Compra pendiente/pagada. En ventas se interpreta por cobrar/cobrado.
enum PaymentStatus {
  PENDING
  PARTIAL // con abonos registrados, sin cubrir el total
  PAID
}

// Estado de una factura de venta. Más granular que PaymentStatus:
// permite marcar parcialidades, vencimientos y anulaciones.
enum SaleStatus {
  PENDING // Por cobrar
  PAID // Cobrado
  PARTIAL // Parcialmente cobrado
  OVERDUE // Vencida (sin pagar, fecha límite pasada)
  CANCELLED // Anulada
}

model Purchase {
  id                   String         @id @default(cuid())
  companyId            String
  date                 DateTime
  dueDate              DateTime?
  partnerId            String
  categoryId           String?
  areaId               String?
  documentType         DocumentType   @default(INVOICE)
  documentNumber       String?
  referenceDocumentNumber String? // folio del documento original en notas de crédito/débito
  purchaseOrder        String?
  dispatchGuide        String?
  hesNumber            String?
  facturaOriginal      String? // folio del documento original (notas)
  tipoDocRefOriginal   String? // tipo de documento original (33/34)
  fechaRecepcion       DateTime? // fecha de recepción del SII
  estadoReceptor       String? // estado del receptor en el SII (A/R)
  description          String?
  xmlContent           String? // XML DTE original: el PDF lo parsea al vuelo
  netAmount            Int
  ivaAmount            Int            @default(0)
  exento               Int            @default(0) // monto exento del XML
  ivaRecargo           Int            @default(0) // IVA recargo del XML
  totalAmount          Int
  tasaIVA              Float? // tasa de IVA del XML (ej: 19)
  formaPago            String? // CONTADO | CRÉDITO | SIN COSTO
  status               PaymentStatus  @default(PENDING)
  paymentDate          DateTime?
  // El medio de pago es el NOMBRE del catálogo de la empresa
  // (PaymentMethodCatalog), no una lista fija: cada empresa tiene las formas
  // de pago que necesita (la tarjeta de un banco, un vale, una transferencia
  // a una cuenta concreta).
  paymentMethod           String?
  notes                String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner   Partner        @relation(fields: [partnerId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  area      Area?          @relation(fields: [areaId], references: [id])
  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items     PurchaseItem[]
  bankReconciliations Reconciliation[]
  payments            Payment[]

  @@index([companyId, date])
  @@index([companyId, partnerId])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, areaId])
}

model Sale {
  id                   String         @id @default(cuid())
  companyId            String
  date                 DateTime
  dueDate              DateTime?
  partnerId            String
  categoryId           String?
  areaId               String?
  salespersonId        String?
  documentType         DocumentType   @default(INVOICE)
  documentNumber       String?
  referenceDocumentNumber String? // folio del documento original en notas de crédito/débito
  purchaseOrder        String?
  dispatchGuide        String?
  hesNumber            String?
  description          String?
  xmlContent           String? // XML DTE original: el PDF lo parsea al vuelo
  netAmount            Int
  ivaAmount            Int            @default(0)
  totalAmount          Int
  retentionAmount      Int            @default(0)

  // Campos adicionales del XML DTE para mejor identificación y registro
  formaPago            String? // CONTADO | CRÉDITO | SIN COSTO
  exento               Int            @default(0) // monto exento del XML
  ivaRecargo           Int            @default(0) // IVA recargo del XML
  tasaIVA              Float? // tasa de IVA del XML (ej: 19)
  facturaOriginal      String? // folio del documento original (notas)
  tipoDocRefOriginal   String? // tipo de documento original (33/34)
  fechaRecepcion       DateTime? // fecha de recepción del SII
  estadoReceptor       String? // estado del receptor en el SII (A/R)
  status               SaleStatus     @default(PENDING)
  paymentDate          DateTime?
  confirmingAt         DateTime?
  paymentMethod      String?
  notes                String?

  // Cancelación: cuando status=CANCELLED, estos campos indican el motivo.
  cancellationType     String? // CREDIT_NOTE | DEBIT_NOTE | REASON
  cancellationNoteNumber String? // folio de la NC/ND asociada (obligatorio si type es NC/ND)
  cancellationReason   String? // razón libre (obligatorio si type es REASON)
  cancellationComment  String? // comentario opcional sobre la anulación
  refacturadaNumber    String? // folio de la factura que reemplazó a la anulada

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner     Partner      @relation(fields: [partnerId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  area        Area?        @relation(fields: [areaId], references: [id])
  salesperson Salesperson? @relation(fields: [salespersonId], references: [id])
  createdBy   User         @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items       SaleItem[]

  bankReconciliations  Reconciliation[]
  payments             Payment[]

  // Un documento tiene a lo sumo una asignación de comisión (único por documento).
  commissionAssignment CommissionAssignment?
  commissionEntries    CommissionEntry[]

  @@unique([companyId, documentNumber])
  @@index([companyId, date])
  @@index([companyId, partnerId])
  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, areaId])
  @@index([companyId, salespersonId])
}

// Abono: un pago real aplicado a una compra (pago al proveedor) o a una venta
// (cobro del cliente). El saldo de un documento es su total menos la suma de sus
// abonos; el estado se deriva de ahí (nada → PENDING, parte → PARTIAL, todo →
// PAID). Un abono pertenece a un solo documento: o compra o venta, nunca ambas.
model Payment {
  id          String        @id @default(cuid())
  companyId   String
  date        DateTime
  amount      Int
  method      String?
  notes       String?
  purchaseId  String?
  saleId      String?
  createdById String
  createdAt   DateTime      @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User      @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, date])
  @@index([companyId, purchaseId])
  @@index([companyId, saleId])
}

// Detalle de una compra: las líneas que trae el XML del proveedor (DscItem).
// `productId` solo se rellena si el nombre del ítem coincide exactamente con un
// producto del catálogo; si no, queda en null y el ítem se muestra "sin vincular".
// El neto del documento no se recalcula desde aquí: manda el encabezado.
model PurchaseItem {
  id         String  @id @default(cuid())
  companyId  String
  purchaseId String
  productId  String?
  name       String // descripción del ítem tal como viene en el documento
  quantity   Decimal @db.Decimal(14, 3) @default(1)
  unitPrice  Int     @default(0) // precio neto unitario (redondeado a CLP)
  amount     Int     @default(0) // neto del ítem
  position   Int     @default(0) // orden original en el documento

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product?         @relation("PurchaseItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([companyId, productId])
}

// Detalle de una venta: mismo esquema que PurchaseItem (líneas del EnvioDTE).
model SaleItem {
  id        String  @id @default(cuid())
  companyId String
  saleId    String
  productId String?
  name      String
  quantity  Decimal @db.Decimal(14, 3) @default(1)
  unitPrice Int     @default(0)
  amount    Int     @default(0) // neto del ítem
  position  Int     @default(0)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation("SaleItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([companyId, productId])
}

// ---------------------------------------------------------------------------
// Comisiones de vendedores
//
// Tres piezas: la ASIGNACIÓN (el documento → mes de comisión), la ENTRADA
// (la línea ya calculada, congelada al cierre) y el CIERRE (el sello del mes).
// ---------------------------------------------------------------------------

// De dónde sale una línea de comisión.
enum CommissionSource {
  AUTO   // Entró sola por la fecha de la factura y la regla del vendedor.
  MANUAL // Se asignó a mano: guías o facturas rezagadas de otros meses.
}

// Documento → mes de comisión. Aquí viven las guías de despacho rezagadas.
// Es único por documento: una factura NUNCA puede comisionarse en dos meses.
// Si tiene asignación, queda fuera del cómputo automático en su mes de
// emisión, para que no se cuente dos veces.
// Puede referenciar una venta (saleId) o una guía de despacho sin facturar (dispatchGuideId).
model CommissionAssignment {
  id                String   @id @default(cuid())
  companyId         String
  saleId            String?  @unique // 1:1 con Sale. Un documento, una sola asignación.
  dispatchGuideId   String?  @unique // 1:1 con DispatchGuide. Lo mismo: una guía, un mes.
  period            String // "2026-09": mes de comisión al que se asigna
  salespersonId     String // vendedor que cobra; por defecto el de la factura/guía
  note              String?
  createdById       String
  createdAt         DateTime @default(now())

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale              Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  dispatchGuide     DispatchGuide? @relation(fields: [dispatchGuideId], references: [id], onDelete: Cascade)
  salesperson       Salesperson   @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("CommissionAssignmentCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, period])
  @@index([companyId, salespersonId])
}

// Línea de comisión ya calculada. Se materializa al CERRAR el mes y queda
// congelada: `rateBps` y `amount` son los vigentes al cierre, no los de hoy.
// Por eso una anulación posterior no descuadra lo ya pagado.
// La entrada puede provenir de una venta (saleId) o de una guía de despacho
// sin facturar (dispatchGuideId).
model CommissionEntry {
  id             String          @id @default(cuid())
  companyId      String
  period         String // "2026-09"
  salespersonId  String
  saleId         String?
  dispatchGuideId String?
  source         CommissionSource @default(AUTO)
  baseAmount     Int // neto computado, con signo: las notas de crédito restan
  rateBps        Int // tasa congelada al cierre, en centésimas
  amount         Int // comisión en pesos, redondeada
  createdAt      DateTime        @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesperson  Salesperson   @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  dispatchGuide DispatchGuide? @relation(fields: [dispatchGuideId], references: [id], onDelete: Cascade)

  @@unique([companyId, period, saleId])
  @@unique([companyId, period, dispatchGuideId])
  @@index([companyId, period, salespersonId])
}

// Sello de un mes cerrado. Después de cerrado, el motor lo ignora.
model CommissionClose {
  id         String   @id @default(cuid())
  companyId  String
  period     String // "2026-09"
  closedAt   DateTime @default(now())
  closedById String

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closedBy User    @relation("CommissionCloseClosedBy", fields: [closedById], references: [id])

  @@unique([companyId, period])
  @@index([companyId])
}

// Guía de despacho emitida pero todavía sin factura. El vendedor quiere
// comisionar estas guías aunque la factura llegue en otro mes. Se registran
// aquí y se asignan manualmente al mes de comisión que corresponda.
model DispatchGuide {
  id             String   @id @default(cuid())
  companyId      String
  guideNumber    String // número de guía de despacho
  date           DateTime // fecha de la guía (fecha de despacho)
  partnerId      String
  salespersonId  String? // vendedor que cobra por esta guía; null si se trajo del RCV de compra (el emisor es el proveedor)
  netAmount      Int      // neto de la guía, en pesos
  note           String?  // observación opcional (ej: motivo del arrastre)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner       Partner               @relation(fields: [partnerId], references: [id])
  salesperson   Salesperson?          @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  createdBy     User                  @relation("DispatchGuideCreatedBy", fields: [createdById], references: [id])
  assignment    CommissionAssignment?
  entries       CommissionEntry[]

  @@unique([companyId, guideNumber])
  @@index([companyId, date])
  @@index([companyId, salespersonId])
}

model Expense {
  id             String        @id @default(cuid())
  companyId      String
  date           DateTime
  description    String
  categoryId     String?
  areaId         String?
  workerId       String?
  documentNumber String?
  netAmount      Int
  ivaAmount      Int           @default(0)
  totalAmount    Int
  paymentMethod  String        @default("Efectivo")
  reimbursed     Boolean       @default(false)
  reimbursedAt   DateTime?
  notes          String?

  paidById    String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  area      Area?     @relation(fields: [areaId], references: [id])
  worker    Worker?   @relation(fields: [workerId], references: [id])
  paidBy    Payer     @relation(fields: [paidById], references: [id])
  createdBy User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  remunerations   Remuneration[]
  payrollEntries  PayrollEntry[]
  // El movimiento bancario con que se cerró: es el reembolso a quien pagó.
  bankReconciliations Reconciliation[]

  @@index([companyId, date])
  @@index([companyId, paidById])
  @@index([companyId, workerId])
  @@index([companyId, categoryId])
  @@index([companyId, areaId])
}

// ---------------------------------------------------------------------------
// Notificaciones: alertas internas (por ejemplo, vencimientos) que se ven en el
// panel. No se envía correo: el equipo entra todos los días a la aplicación.
// ---------------------------------------------------------------------------

enum NotificationType {
  PURCHASE_DUE_SOON
  PURCHASE_OVERDUE
  SALE_DUE_SOON
  SALE_OVERDUE
  LIMIT_EXCEEDED
}

model Notification {
  id        String           @id @default(cuid())
  companyId String
  type      NotificationType
  title     String
  message   String
  href      String?
  // Clave estable para no duplicar la misma alerta al recalcular.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, dedupeKey])
  @@index([companyId, readAt])
  @@index([companyId, createdAt])
}

// ---------------------------------------------------------------------------
// Auditoría: rastro de quién hizo qué y cuándo.
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
}

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  userId     String? // se guarda el id como texto; el log sobrevive si se borra el usuario
  userName   String
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  createdAt  DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}
// Periodo de nomina (liquidacion mensual).
enum PayrollStatus {
  DRAFT
  CLOSED
}

model PayrollPeriod {
  id          String          @id @default(cuid())
  companyId   String
  year        Int
  month       Int
  status      PayrollStatus   @default(DRAFT)
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  ratesSource String?
  indicatorsSnapshot Json?

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User           @relation("PayrollPeriodCreatedBy", fields: [createdById], references: [id])
  entries    PayrollEntry[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
}

// Liquidacion individual de un trabajador en un periodo.
model PayrollEntry {
  id             String         @id @default(cuid())
  periodId       String
  workerId       String
  baseAmount     Int
  allowances     Int            @default(0)
  overtime       Int            @default(0)
  grossAmount    Int
  afpAmount      Int            @default(0)
  healthAmount   Int            @default(0)
  unemploymentAmount Int        @default(0)
  taxAmount      Int            @default(0)
  otherDeductions Int           @default(0)
  deductionsTotal Int
  netAmount      Int
  expenseId      String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  worker   Worker        @relation(fields: [workerId], references: [id])
  expense  Expense?      @relation(fields: [expenseId], references: [id])

  @@unique([periodId, workerId])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Lotes de producto y vencimiento
// ---------------------------------------------------------------------------

model ProductLot {
  id             String   @id @default(cuid())
  companyId      String
  productId      String
  warehouseId    String?
  code           String
  expirationDate DateTime? @db.Date
  quantity       Decimal  @db.Decimal(14, 3) @default(0)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy User       @relation("ProductLotCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productId])
  @@index([expirationDate])
  @@index([companyId, expirationDate])
}

// ---------------------------------------------------------------------------
// Conciliación bancaria (movimientos vía open-banking-chile)
// ---------------------------------------------------------------------------

// Una cuenta o tarjeta vigilada por la conciliación. `label` distingue
// cuentas y tarjetas de un mismo banco (lo entrega el scraper).
model BankAccount {
  id         String    @id @default(cuid())
  companyId  String
  bankId     String // id del scraper: "santander", "bchile", ...
  label      String
  kind       String    @default("account") // account | credit_card
  balance    Int? // último saldo conocido (CLP)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements BankMovement[]

  @@unique([companyId, bankId, label])
  @@index([companyId])
}

// Un movimiento bancario importado. `fingerprint` (fecha + monto + descripción
// + origen) evita duplicados entre sincronizaciones.
model BankMovement {
  id            String    @id @default(cuid())
  companyId     String
  accountId     String
  date          DateTime  @db.Date
  description   String
  amount        Int // CLP: positivo = abono (cobro), negativo = cargo (pago)
  balance       Int?
  source        String    @default("account") // account | credit_card_unbilled | credit_card_billed
  fingerprint   String
  ignoredAt     DateTime? // marcado como no conciliable por el usuario
  ignoredReason String? // internal_transfer | noise: por qué salió de la bandeja
  createdAt     DateTime  @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account         BankAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reconciliations Reconciliation[]

  @@unique([accountId, fingerprint])
  @@index([companyId, date])
}

// Estado de cada sincronización, para diagnóstico y para avisos en la UI.
model BankSync {
  id         String    @id @default(cuid())
  companyId  String
  bankId     String
  status     String // running | success | error
  message    String?
  imported   Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  userId     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("BankSyncBy", fields: [userId], references: [id])

  @@index([companyId, startedAt])
}

// El vínculo entre un movimiento bancario y el documento que paga o cobra.
model Reconciliation {
  id          String   @id @default(cuid())
  companyId   String
  movementId  String   @unique
  purchaseId  String?
  saleId      String?
  expenseId   String?
  createdAt   DateTime @default(now())
  createdById String

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movement BankMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  purchase Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale     Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  expense  Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  user     User         @relation("BankReconciliationBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([purchaseId])
  @@index([saleId])
  @@index([expenseId])
}

// ---------------------------------------------------------------------------
// Expediente del alumno: documentos y consentimientos
// ---------------------------------------------------------------------------

// Los documentos se guardan en la base, como los del trabajador en el módulo de
// Facturas (`WorkerDocument`): el archivo es de un alumno y vive con él, no
// con una empresa.
enum StudentDocumentType {
  CERTIFICADO_NACIMIENTO
  CERTIFICADO_ESTUDIOS
  FICHA_MEDICA
  CUSTODIA
  OTRO
}

// Para qué se pide consentimiento. La Ley 21.719 exige que sea específico:
// un "sí" genérico no sirve (art. 14).
enum ConsentPurpose {
  DATOS_PERSONALES // tratamiento de datos personales del alumno
  FOTOGRAFIAS // fotos y videos de actividades
  SALUD // datos de salud y planes de apoyo
  ACTIVIDADES // actividades extraescolares y salidas
  VIAJES // viajes y traslados fuera del colegio
}

enum ConsentStatus {
  PENDIENTE
  OTORGADO
  REVOCADO
}

model StudentDocument {
  id           String             @id @default(cuid())
  schoolId     String
  studentId    String
  type         StudentDocumentType @default(OTRO)
  title        String
  description  String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  fileData     Bytes
  uploadedById String
  createdAt    DateTime           @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

model StudentConsent {
  id            String         @id @default(cuid())
  schoolId      String
  studentId     String
  purpose       ConsentPurpose
  status        ConsentStatus  @default(PENDIENTE)
  grantedAt     DateTime?
  grantedBy     String? // quién firmó: el apoderado, en nombre del titular
  method        String? // PRESENCIAL, DIGITAL, TESTIMONIO
  revokedAt     DateTime?
  revokedReason String?
  notes         String?
  recordedById  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, purpose])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Calificaciones y promoción (Decreto 67/2018)
// ---------------------------------------------------------------------------

// El régimen de evaluación: semestral o trimestral. No lo impone el decreto
// (cada colegio lo fija en su reglamento), así que se configura por colegio.
enum GradingPeriodType {
  SEMESTRE
  TRIMESTRE
}

enum EvaluationType {
  DIAGNOSTICA
  PRUEBA
  TRABAJO
  EXPOSICION
  EXAMEN
  OTRO
}

enum GradeStatus {
  PENDIENTE // todavía sin nota
  GRADED // calificada
  EXENTO // no rindió la evaluación: no cuenta para el promedio
}

model GradingPeriod {
  id       String            @id @default(cuid())
  schoolId String
  name     String // "Primer semestre", "Primer trimestre"
  type     GradingPeriodType @default(SEMESTRE)
  startDate DateTime
  endDate   DateTime
  // Ponderación del período sobre el promedio final del año (60, 40...).
  // La define el reglamento del colegio: el Decreto 67 no la fija.
  weight Int @default(0)
  // Orden en que se muestran (1, 2, 3...).
  order     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@unique([schoolId, name])
  @@index([schoolId, order])
}

model Evaluation {
  id        String         @id @default(cuid())
  schoolId  String
  courseId  String
  subjectId String
  periodId  String
  name      String // "Prueba 1", "Trabajo unidad 2"
  type      EvaluationType @default(PRUEBA)
  date      DateTime
  // Ponderación dentro de la asignatura (%). Si ninguna evaluación tiene
  // ponderación, todas pesan lo mismo.
  weight Int @default(0)
  // Evaluación final del período: su ponderación no puede pasar del 30%
  // (Art. 18 h) del Decreto 67/2018.
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject  Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period   GradingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  grades   Grade[]

  @@index([courseId, periodId])
  @@index([subjectId, periodId])
  @@index([schoolId, date])
}

model Grade {
  id           String      @id @default(cuid())
  evaluationId String
  studentId    String
  // Nota de 1.0 a 7.0 con un decimal (Art. 8 del Decreto 67/2018).
  value        Float?
  status       GradeStatus @default(PENDIENTE)
  note         String?
  // Quién把那 nota (la Circular N°30 pide trazabilidad de cada dato).
  recordedById String
  recordedAt   DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Comunicación: circulares, justificaciones y citaciones (C4)
// ---------------------------------------------------------------------------

// A quién va la circular. "FAMILIA" es para una familia en particular.
enum CircularAudience {
  COLEGIO
  CURSO
  FAMILIA
}

model Circular {
  id       String          @id @default(cuid())
  schoolId String
  title    String
  body     String
  audience CircularAudience @default(COLEGIO)
  // Si el público es un curso, estos son los que la reciben.
  courseId String?
  // Si es para una familia en particular.
  guardianId String?
  publishedAt DateTime        @default(now())
  // Hasta cuándo se puede leer (después queda de archivo).
  closesAt  DateTime?
  createdById String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course   Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  guardian Guardian?      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  acks     CircularAck[]

  @@index([schoolId, publishedAt])
}

// El acuse de lectura: quién leyó la circular. Es lo que le sirve al colegio
// para saber a quién hay que volver a avisar.
model CircularAck {
  id         String   @id @default(cuid())
  circularId String
  guardianId String
  readAt     DateTime @default(now())

  circular Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([circularId, guardianId])
  @@index([guardianId])
}

enum JustificationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

// La familia propone justificar una inasistencia. No la justifica por su
// cuenta: lo acepta o lo rechaza la secretaría, que es quien responde por el
// registro de asistencia.
model JustificationRequest {
  id         String             @id @default(cuid())
  schoolId   String
  studentId  String
  sessionId  String
  status     JustificationStatus @default(PENDIENTE)
  reason     String
  note       String?
  requestedByGuardianId String
  requestedAt DateTime          @default(now())
  resolvedAt DateTime?
  resolvedById String?
  resolution String?

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session  ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guardian Guardian     @relation(fields: [requestedByGuardianId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId])
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  REALIZADA
  CANCELADA
}

// Una citación: una entrevista o reunión con la familia.
model Appointment {
  id         String            @id @default(cuid())
  schoolId   String
  studentId  String
  guardianId String?
  title      String
  reason     String?
  scheduledAt DateTime
  durationMin Int              @default(30)
  place      String?
  status     AppointmentStatus @default(PENDIENTE)
  notes      String?
  // Lo que respondió la familia.
  response   String?
  respondedAt DateTime?
  createdById String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([schoolId, scheduledAt])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Convivencia escolar (Ley 21.809, vigente desde el 1-jul-2026)
// ---------------------------------------------------------------------------

enum ConductCaseType {
  CONDUCTA // conducta disruptiva
  ACOSO_ESCOLAR // acoso escolar (entre estudiantes)
  AGRESION // agresión física o verbal
  MALTRATO_INFANTIL // sospecha de maltrato
  DISCRIMINACION
  ACOSO_LABORAL // entre adultos (Ley Karin)
  SALUD_MENTAL // bienestar socioemocional
  OTRO
}

enum ConductCaseStatus {
  ABIERTO
  EN_INVESTIGACION
  MEDIACION
  RESUELTO
  CERRADO
}

enum CaseParticipantRole {
  DENUNCIANTE
  DENUNCIADO
  AFECTADO
  TESTIGO
}

enum ConductActionType {
  RECEPCION
  INVESTIGACION
  ENTREVISTA
  CITACION
  MEDIACION
  INFORME_COMISION
  SANCTION
  SUSPENSION
  EXPULSION
  DERIVACION
  REPOSICION
  CIERRE
}

// Un caso de convivencia: la denuncia y su seguimiento.
//
// El plazo de investigación NO es un dato del colegio: la Ley 21.809 fija que
// la investigación interna de un caso de alumno no puede pasar de 2 meses. El
// sistema lo calcula al abrir el caso y avisa cuando se vence.
model ConductCase {
  id          String            @id @default(cuid())
  schoolId    String
  type        ConductCaseType   @default(CONDUCTA)
  // "LEVE" | "MEDIA" | "GRAVE"
  severity    String            @default("LEVE")
  title       String
  description String
  status      ConductCaseStatus @default(ABIERTO)
  // La Ley 21.809 fija que la investigación de un caso de alumno no puede
  // pasar de 2 meses. El colegio no lo acorta: lo acorta la ley.
  investigationDueAt DateTime
  reportedById       String
  reportedAt         DateTime        @default(now())
  closedAt           DateTime?
  resolution         String?
  // Si hubo medida de expulsión o cancelación de matrícula, la ley exige el
  // informe de una comisión (profesor jefe, coordinador de convivencia y un
  // técnico-pedagógico). Se guarda acá.
  commissionReport String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants CaseParticipant[]
  actions      ConductAction[]

  @@index([schoolId, status])
  @@index([schoolId, investigationDueAt])
}

// Quién participa del caso y en qué calidad.
model CaseParticipant {
  id        String              @id @default(cuid())
  caseId    String
  studentId String
  role      CaseParticipantRole @default(AFECTADO)
  note      String?

  caso    ConductCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([caseId, studentId, role])
  @@index([studentId])
}

// Una acción del caso: una etapa del protocolo, con su plazo y su responsable.
model ConductAction {
  id         String             @id @default(cuid())
  caseId     String
  type       ConductActionType
  title      String
  notes      String?
  // El plazo de la etapa. Si el protocolo del colegio lo define, se hereda.
  dueAt      DateTime?
  doneAt     DateTime?
  outcome    String?
  // Quién quedó a cargo. Es un id de usuario del colegio (el personal del
  // colegio es un User con membresía escolar).
  responsibleId String?
  responsible   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt

  caso ConductCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, dueAt])
  @@index([dueAt])
}

// El protocolo del colegio (el RICE y sus protocolos): las etapas con su plazo.
//
// Los pasos se guardan como JSON porque son la configuración del protocolo y
// cambian por versión; lo que se sigue en el tiempo (los casos) vive en tablas.
model ConductProtocol {
  id       String   @id @default(cuid())
  schoolId String
  name     String
  // "CONVIVENCIA" | "MALTRATO" | "ACOSO" | "ACOSO_LABORAL" | "DISCRIMINACION"
  kind     String   @default("CONVIVENCIA")
  version  Int      @default(1)
  // Los pasos: [{ name, deadlineDays, responsible }]
  steps    Json
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name, version])
  @@index([schoolId, active])
}

// El Plan de Gestión de la Convivencia Escolar: obligatorio por la Ley 21.809
// y con revisión participativa cada 4 años.
model ConvivenciaPlan {
  id       String   @id @default(cuid())
  schoolId String
  year     Int
  // "BORRADOR" | "APROBADO" | "VIGENTE"
  status   String   @default("BORRADOR")
  // Los objetivos del plan.
  objectives Json
  // Cuándo se hace la revisión participativa (la ley pide cada 4 años).
  reviewDueAt DateTime?
  approvedAt  DateTime?
  // La constancia de que se entregó copia a las familias (la ley lo pide).
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  activities PlanActivity[]

  @@unique([schoolId, year])
}

// Las acciones del plan. Las áreas son las que la ley menciona: participación,
// igualdad, resolución pacífica, mediación, cuidados y responsabilidades
// digitales, desarrollo socioemocional y salud mental.
model PlanActivity {
  id        String   @id @default(cuid())
  planId    String
  name      String
  // "PARTICIPACION" | "IGUALDAD" | "RESOLUCION_PACIFICA" | "MEDIACION" |
  // "CUIDADOS_DIGITALES" | "SOCIOEMOCIONAL" | "SALUD_MENTAL"
  area      String
  responsible String?
  dueAt     DateTime?
  doneAt    DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  plan ConvivenciaPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dueAt])
}
