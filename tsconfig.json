{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev2/types/**/*.ts",
    ".next-dev2/dev/types/**/*.ts",
    ".next-dev3/types/**/*.ts",
    ".next-dev3/dev/types/**/*.ts",
    "**/*.mts",
    ".next-dev4/types/**/*.ts",
    ".next-dev4/dev/types/**/*.ts",
    ".next-dev5/types/**/*.ts",
    ".next-dev5/dev/types/**/*.ts",
    ".next-dev6/types/**/*.ts",
    ".next-dev6/dev/types/**/*.ts",
    ".next-dev7/types/**/*.ts",
    ".next-dev7/dev/types/**/*.ts",
    ".next-dev8/types/**/*.ts",
    ".next-dev8/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
