# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# instancia de desarrollo paralela (NEXT_DIST_DIR)
/.next-dev2/

# production
/build

# misc
.DS_Store
*.pem

# certificados (la CA de Coolify es específica de cada entorno)
/certs
*.crt

# skills locales del agente de Prisma
/.agents
/.claude
/.windsurf
/skills-lock.json

# script local con la contraseña del admin incrustada: nunca subir. La versión compartida,
# que lee la clave del entorno, vive en scripts/reset-password.ts
/reset-password.mjs

# archivos temporales del agente
_*.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
