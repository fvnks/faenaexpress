# Conexión real a PostgreSQL. En local apunta a tu servidor; en el VPS la define Coolify.
# Si el servidor usa TLS con una CA propia, agrega: ?sslmode=verify-full&sslrootcert=./certs/mi-ca.crt
DATABASE_URL="postgresql://usuario:clave@localhost:5432/facturas?schema=public"

# Conexión para la CLI de Prisma a través del puente TLS local (scripts/prisma-with-bridge.mjs).
# Requerido en Windows: el motor de Prisma no puede negociar TLS con servidores de certificado ECDSA.
# Si usas una base local sin TLS, puedes omitirlo (la CLI usará DATABASE_URL).
PRISMA_DATABASE_URL="postgresql://usuario:clave@127.0.0.1:15433/facturas?sslmode=disable"

# Datos del administrador inicial (los usa `prisma db seed`).
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@facturas.local"
ADMIN_PASSWORD="cambia-esta-clave"
COMPANY_NAME="Mi Empresa"

# Directorio de la sesión del SII (login desde Importar). Default: ~/.sii.
# En Coolify monta un volumen persistente aquí (ej. /app/.sii, como en el Dockerfile).
# SII_HOME="/app/.sii"

# Llave para cifrar la Clave Tributaria que cada empresa guarda en
# Configuración → Credenciales del SII (AES-256-GCM). Si la cambias, las
# credenciales guardadas quedan ilegibles y hay que volver a guardarlas.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SII_SECRET_KEY=""

# Indicadores previsionales (Previred). Si está definida, genera tasas legales por período/trabajador.
# PREVIRED_API_TOKEN=
# PREVIRED_API_BASE_URL="https://apigateway.cl/api/v2/previred/indicadores/data"

# Conciliación bancaria (sección Banco). Ruta al ejecutable de Chrome/Chromium
# que abre el scraper. Normalmente no hace falta: se detecta Chrome instalado
# (Windows/macOS/Linux) o el Chromium que trae la imagen Docker (Playwright).
# Defínela solo si el navegador está en una ruta no estándar.
# OB_CHROME_PATH="/usr/bin/google-chrome-stable"

# Perfil de despliegue (ver src/lib/deployment.ts):
#   standalone = instalación privada de una empresa (default): `/` redirige a sesión/login.
#   saas        = Yellow ERP (yellow-erp.cl): `/` muestra la landing pública.
# DEPLOYMENT_PROFILE="standalone"
