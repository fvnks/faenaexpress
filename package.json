{
  "name": "facturas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-run.mjs migrate dev",
    "db:deploy": "node scripts/prisma-run.mjs migrate deploy",
    "db:drift": "node scripts/prisma-run.mjs migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:baseline": "tsx scripts/baseline-db.ts",
    "db:studio": "node scripts/prisma-run.mjs studio",
    "db:bridge": "node scripts/pg-tls-bridge.mjs"
  },
  "dependencies": {
    "@albertomarturelo/sii-core": "^0.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "next": "16.4.0",
    "open-banking-chile": "^2.1.2",
    "pdf417-generator": "^1.1.1",
    "playwright": "^1.64.0",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.5.1"
}
